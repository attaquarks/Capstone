# .dockerignore — keeps the build context lean and the runtime image
# secret-free. Only files that are NOT needed at runtime should be excluded.

# --- Secrets (must NEVER end up in the image) ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Local databases & artefacts (state belongs in volumes, not images) ---
checkpoint_db.sqlite
checkpoints/
feedback_log.db
chroma_db/
*.db
*.sqlite

# --- Python build caches & virtualenvs ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
.venv/
venv/
env/
.eggs/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Version control ---
.git/
.gitignore
.github/

# --- IDE / OS noise ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Build / log artefacts ---
docker_build.log
build/
dist/
node_modules/

# --- Documentation that doesn't need to ship ---
*.md
!README.md
PLAN.md
REPORT.md

# --- The Dockerfile + compose are not needed inside the image itself ---
Dockerfile
docker-compose.yaml
docker-compose.override.yaml
.dockerignore

# IMPORTANT: Initial_Data/ (CSV + product specs) is intentionally NOT excluded
# — the agent reads those files at runtime via tools.py. Likewise,
# eval_thresholds.json and test_dataset.json are kept so containerised runs
# can self-evaluate.
