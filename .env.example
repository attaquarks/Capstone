# Copy to `.env` (git-ignored) and fill in real values before running
# `docker compose up`. The .env file is also excluded from the image by
# .dockerignore — secrets only ever live in the runtime environment.

# --- Default backend: Google Gemini ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- Optional fallback backend: Groq (Llama-3 / Mixtral / Gemma on Groq) ---
# When GROQ_API_KEY is set the agent and the eval judge automatically use
# Groq instead of Gemini. Useful when the Gemini free-tier daily quota
# (20 RPD per model) is exhausted. Force the choice explicitly with
# LLM_PROVIDER=groq or LLM_PROVIDER=google.
# GROQ_API_KEY=your-groq-api-key-here
# LLM_PROVIDER=groq

# --- Optional model overrides ---
# Defaults: Gemini -> gemini-2.5-flash / gemini-2.5-flash-lite,
#           Groq   -> llama-3.3-70b-versatile / llama-3.1-8b-instant.
# AGENT_MODEL=gemini-2.5-flash
# JUDGE_MODEL=gemini-2.5-flash-lite
