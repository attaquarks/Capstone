# Supply Chain Intelligence Agent - Environment Variables
# Copy this file to .env and fill in your values

# Google Gemini API Key (required for LLM calls)
GEMINI_API_KEY=your_google_api_key_here

# LangSmith Observability (optional - Lab 7)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=supply-chain-agent

# ChromaDB (for Docker deployment)
CHROMA_HOST=chromadb
CHROMA_PORT=8001

# Evaluation thresholds (can also use eval_threshold_config.json)
MIN_FAITHFULNESS=0.7
MIN_RELEVANCY=0.75
MIN_TOOL_ACCURACY=0.8
